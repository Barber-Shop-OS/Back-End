{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "nodemon ./server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:reset": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate",
    "migrate:status": "npx sequelize-cli db:migrate:status",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"*.js\"",
    "start": "node server.js",
    "test:pg": "cross-env TEST_DB_DIALECT=postgres jest --runInBand --forceExit",
    "billing:sync-products": "node scripts/billing-sync-products.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "revoke-sessions": "node scripts/revoke-sessions.js",
    "openapi:export": "node scripts/openapi-export.js",
    "migrate:release": "node scripts/migrate-release.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.890.0",
    "@aws-sdk/s3-request-presigner": "^3.890.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.23",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.9",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/migrations/**",
      "!src/config/**"
    ],
    "setupFiles": [
      "<rootDir>/src/__tests__/helpers/setupEnv.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 65,
        "functions": 90,
        "lines": 85
      },
      "./src/modules/**/*Service.js": {
        "lines": 80
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}
