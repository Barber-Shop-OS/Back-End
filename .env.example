# Ambiente: development | test | production
NODE_ENV=development
PORT=3000

# Banco MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=barberos
DB_PASS=troque_esta_senha
# Usado apenas pelo docker-compose para o usuário root do MySQL local.
DB_ROOT_PASS=troque_esta_senha_root
DB_NAME=barbershop_db
DB_SSL=false

# JWT — obrigatório, mínimo 32 caracteres. Gere com: openssl rand -base64 48
# A API não sobe com valor de exemplo.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Origens do front-end autorizadas (separadas por vírgula). Obrigatório em produção.
CORS_ORIGINS=http://localhost:5173

# E-mail transacional: log (só registra) | smtp
MAIL_DRIVER=log
MAIL_FROM="BarberOS <nao-responda@barberos.app>"
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# Worker da fila de e-mails/lembretes no processo da API (BE-16). false = desligado.
JOBS_WORKER=true
# URL pública do front (links em e-mails e retorno do checkout)
APP_URL=http://localhost:5173

# Cobrança da assinatura SaaS — AbacatePay API v2 (BE-32/33). Sem a chave, /api/billing responde 503.
# Chave abc_dev_... = modo teste (sandbox). Depois de configurar: npm run billing:sync-products
ABACATEPAY_API_KEY=
# Métodos do checkout: CARD e/ou PIX (PIX recorrente exige Pix Automático habilitado na conta)
ABACATEPAY_METHODS=CARD
# Segredo do webhook (32+ caracteres), o mesmo cadastrado no painel da AbacatePay
ABACATEPAY_WEBHOOK_SECRET=
# Chave pública da AbacatePay para conferir X-Webhook-Signature (HMAC-SHA256 do corpo cru). Opcional.
ABACATEPAY_WEBHOOK_PUBLIC_KEY=

# Login com Google (BE-28): Client ID OAuth "Web" do Google Cloud (o mesmo do front). Sem ele, /api/auth/google responde 503.
GOOGLE_CLIENT_ID=

# Cookie do refresh token (BE-30): strict (padrão, front e API no mesmo site) | lax | none (sites diferentes; exige HTTPS)
REFRESH_COOKIE_SAMESITE=strict

# Proxies confiáveis à frente da API (BE-42): 0 local; 1 atrás de Render/Cloudflare
TRUST_PROXY=0

# Upload de imagens (BE-34) — Cloudflare R2 (S3). Sem estas variáveis, /api/uploads responde 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública do bucket (domínio próprio ou r2.dev), usada nas imagens salvas
R2_PUBLIC_BASE_URL=
# Opcional: endpoint S3 alternativo (MinIO/s3mock locais) e caminho no estilo /bucket/chave
R2_ENDPOINT=
R2_FORCE_PATH_STYLE=false

# Deploy (BE-44): false = boot só valida o schema; migrations no passo de release (npm run migrate:release)
MIGRATE_ON_BOOT=true
# TLS do banco validando a CA do provedor: conteúdo PEM (com 
) ou caminho do arquivo
DB_SSL_CA=

# App mobile (BE-48 / MOB-18): versão mínima suportada, última versão e aviso de manutenção
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
MAINTENANCE_MESSAGE=
TERMS_VERSION=2026-11

# Push do app mobile (BE-45) via Expo Push API. EXPO_ACCESS_TOKEN opcional (segurança reforçada do Expo).
EXPO_ACCESS_TOKEN=
# Só para testes locais: URL alternativa da API de push
EXPO_PUSH_URL=
