      "path": "/auth",
      "public": true,
      "endpoints": [
        {
          "method": "POST",
          "path": "/auth/register",
          "summary": "Cadastrar novo usuário",
          "authenticated": false,
          "rateLimit": true,
          "roles": [],
          "request": {
            "name": "string",
            "email": "string",
            "password": "string (min 6)"
          },
          "responses": {
            "201": "Usuário cadastrado com sucesso",
            "400": "Dados inválidos",
            "409": "E-mail já cadastrado"
          }
        },
        {
          "method": "POST",
          "path": "/auth/login",
          "summary": "Autenticar usuário",
          "authenticated": false,
          "rateLimit": true,
          "roles": [],
          "request": {
            "email": "string",
            "password": "string"
          },
          "responses": {
            "200": "Login realizado - retorna token",
            "400": "Campos obrigatórios ausentes",
            "401": "Credenciais inválidas"
          }
        },
        {
          "method": "GET",
          "path": "/auth/me",
          "summary": "Obter usuário autenticado",
          "authenticated": true,
          "rateLimit": false,
          "roles": [],
          "responses": {
            "200": "Dados do usuário",
            "401": "Token inválido ou expirado",
            "404": "Usuário não encontrado"
          }
        }
      ]
    },
